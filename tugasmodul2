        "#Tugas 2, belanja di kantin\n",
        "#variabel, nama_makanan, harga_makanan,\n",
        "#jumlah_makanan, nama_minuman, harga_minuman,\n",
        "#jumlah_minuman, total, uang_dibayarkan, kembalian\n",
        "\n",
        "#makanan\n",
        "nama_makanan = input(\"Masukkan nama makanan:\")\n",
        "harga_makanan = int(input(\"Masukkan harga makanan:\"))\n",
        "jumlah_makanan = int(input(\"Masukkan jumlah makanan:\"))\n",
        "\n",
        "#minuman\n",
        "nama_minuman = input(\"Masukkan nama minuman:\")\n",
        "harga_minuman = int(input(\"Masukkan harga minuman:\"))\n",
        "jumlah_minuman = int(input(\"Masukkan jumlah minuman:\"))\n",
        "\n",
        "#total\n",
        "total = (harga_makanan * jumlah_makanan) + (harga_minuman * jumlah_minuman)\n",
        "print(\"Total belanja :\", total)\n",
        "\n",
        "#jumlah bayar\n",
        "uang_dibayarkan = int(input(\"Masukkan jumlah uang yang dibayarkan\"))\n",
        "print(\"Uang yang dibayarkan:\",uang_dibayarkan)\n",
        "\n",
        "#kembalian\n",
        "kembalian = uang_dibayarkan - total\n",
        "print(\"Kembalian:\",kembalian)"
